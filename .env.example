# ── Supabase Configuration ─────────────────────────────────────────────────────
# Default mode is local (all data in localStorage). To enable the multi-tenant
# backend, set VITE_BACKEND_PROVIDER=supabase and provide a project URL + anon key.
# Apply migrations 0001-0022 and run the live RLS/onboarding/recovery smoke test first.
VITE_BACKEND_PROVIDER=local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Hard abort deadline (ms) for every Supabase request made by the browser
# clients (Review #245). Stalled requests abort instead of hanging forever.
# VITE_SUPABASE_FETCH_DEADLINE_MS=30000

# ── Optional: Email / Branding overrides ───────────────────────────────────────
VITE_BRANDING_PRIMARY_COLOR=#4A1942
VITE_SHOW_WELCOME_BY_DEFAULT=true

# ── Demo mode ──────────────────────────────────────────────────────────────────
# When true, the local password-reset flow reveals the generated verification code
# on screen. Production builds must leave this unset (hosted accounts use the
# branded server-side recovery-email flow).
# VITE_DEMO_MODE=false

# ── Production notes ───────────────────────────────────────────────────────────
# - Never commit real keys.
# - Use Supabase CLI or dashboard to run migrations in supabase/migrations/.
# - Enable Row Level Security (RLS) on all tables.
# - The geocode-venue Edge Function needs these as server-only secrets (NEVER in
#   Vercel client env or GitHub):
#     SUPABASE_URL
#     SUPABASE_SERVICE_ROLE_KEY
#     PUBLIC_APP_URL
#     ALLOWED_ORIGIN
#     GEOAPIFY_API_KEY
# - Venue-admin invites send automatically through Brevo from
#   wedding-vip@outlook.com. Set these as send-email Edge Function secrets:
#     BREVO_API_KEY
#     EMAIL_FROM_NAME=Wedding VIP
#     SUPABASE_URL
#     SUPABASE_SERVICE_ROLE_KEY
#   Verify wedding-vip@outlook.com as a Brevo sender first.
# - Password recovery uses the same project-wide delivery key and the same one
#   canonical application origin for every tenant. Required in production:
#     PUBLIC_APP_URL=https://app.your-branded-domain.example
#     PASSWORD_RESET_FROM_EMAIL=no-reply@your-branded-domain.example  # required; verify with the selected delivery service
#   PASSWORD_RESET_APP_URL remains a temporary legacy fallback when
#   PUBLIC_APP_URL is absent; do not configure per-tenant origins.
#   Set the Auth Site URL to the branded production application origin.
#   Do not set EMAIL_FROM to invites@weddingvip.com — that leftover Resend
#   address is ignored. The function always sends as wedding-vip@outlook.com.
