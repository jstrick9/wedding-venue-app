# Supabase Configuration (enable after migrations 0001-0005 and Review #175 live smoke test)
VITE_BACKEND_PROVIDER=local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Email / Branding overrides
VITE_BRANDING_PRIMARY_COLOR=#4A1942
VITE_SHOW_WELCOME_BY_DEFAULT=true

# Production notes:
# - Never commit real keys.
# - Use Supabase CLI or dashboard to run migrations in supabase/migrations/
# - Enable Row Level Security (RLS) on all tables.
# - Configure email templates in Supabase Auth settings.