{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/i/:token", "destination": "/index.html" },
    { "source": "/accept-invite/:token", "destination": "/index.html" },
    { "source": "/venue-onboarding/:token", "destination": "/index.html" },
    { "source": "/reset", "destination": "/index.html" },
    { "source": "/reset/:surface", "destination": "/index.html" }
  ]
}
